# ── Server-only secrets (never prefix with VITE_; these must not reach the browser) ──
# n8n production webhook (Webhook node, method POST). Set this in Vercel > Settings > Environment Variables.
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional shared secret. If set, the API sends it as the X-Webhook-Secret header; verify it in n8n (IF node).
N8N_WEBHOOK_SECRET=
# Optional extra origins allowed to POST to /api/contact (comma separated). Your own domain is allowed automatically.
ALLOWED_ORIGINS=

# ── Public build-time settings (safe to expose) ──
# Canonical site URL, used for sitemap, canonical links and Open Graph URLs.
SITE_URL=https://www.example.com
