    "check": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@vercel/node": "^25.0.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "hls.js": "^1.7.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
